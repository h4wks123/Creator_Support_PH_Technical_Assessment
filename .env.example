# PostgreSQL
# DB_HOST is used by native/local commands. Docker Compose overrides it to "db".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forms_app
DB_USER=forms_app_user
DB_PASS=replace-with-a-strong-database-password

# API
API_PORT=5000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters

# Web-to-API networking
WEB_PORT=3000
# APP_API_URL is used by Next.js server code running inside Docker.
APP_API_URL=http://api:5000
# NEXT_PUBLIC_APP_API_URL is bundled for browser use and is intentionally public.
NEXT_PUBLIC_APP_API_URL=http://localhost:5000

# Webhook consumer and seeded webhook
WEBHOOK_CONSUMER_PORT=4000
WEBHOOK_SECRET=replace-with-a-webhook-secret
# The API reaches the consumer through Docker's internal service DNS.
SEED_WEBHOOK_URL=http://webhook-consumer:4000/webhook
